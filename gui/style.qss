/* Ghost Translator - Ultra Dark OLED Clean Minimalist Theme */

QWidget {
    background-color: #09090b;
    color: #f4f4f5;
    font-family: "Segoe UI", "Segoe UI Variable", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
}

/* Ana Pencere & Tab Bar */
QTabWidget::pane {
    border: 1px solid #1f1f23;
    background-color: #09090b;
    border-radius: 12px;
    margin-top: 6px;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #141417;
    color: #a1a1aa;
    padding: 12px 28px;
    margin-right: 8px;
    margin-bottom: 4px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    border: 1px solid #27272a;
    min-width: 180px;
}

QTabBar::tab:selected {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
}

QTabBar::tab:hover:!selected {
    background-color: #27272a;
    color: #fafafa;
}

/* Giriş Alanları (Inputs) */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: #121215;
    border: 1.5px solid #27272a;
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 14px;
    selection-background-color: #059669;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #10b981;
    background-color: #09090b;
}

/* Açılır Menü (ComboBox) */
QComboBox {
    background-color: #121215;
    border: 1.5px solid #27272a;
    border-radius: 8px;
    padding: 8px 14px;
    color: #ffffff;
    font-size: 13px;
    min-height: 38px;
}

QComboBox:focus, QComboBox:hover {
    border: 1.5px solid #10b981;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #141417;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 6px;
    color: #ffffff;
    selection-background-color: #059669;
    selection-color: #ffffff;
    outline: none;
}

/* Butonlar */
QPushButton {
    background-color: #059669;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #047857;
}

QPushButton:pressed {
    background-color: #065f46;
}

QPushButton:disabled {
    background-color: #27272a;
    color: #52525b;
}

/* İkincil Butonlar */
QPushButton.btn-secondary {
    background-color: #18181b;
    color: #e4e4e7;
    border: 1px solid #27272a;
}

QPushButton.btn-secondary:hover {
    background-color: #27272a;
    border-color: #3f3f46;
}

QPushButton.btn-secondary:checked {
    background-color: #059669;
    color: #ffffff;
    border-color: #10b981;
}

/* Ayarlar Kartı */
QFrame.settings-card {
    background-color: #121215;
    border: 1px solid #222226;
    border-radius: 12px;
    padding: 20px 24px;
}

/* ========================================================================= */
/* KAYDIRMA ÇUBUKLARI (SCROLLBARS) - KUSURSUZ, İNCE VE ÇİZGİSİZ MODER TEMA   */
/* ========================================================================= */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color: #27272a;
    min-height: 40px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #10b981;
}

QScrollBar::handle:vertical:pressed {
    background-color: #059669;
}

QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: transparent;
    height: 0px;
    width: 0px;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    border: none;
    background: transparent;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    border: none;
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #27272a;
    min-width: 40px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #10b981;
}

QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    border: none;
    background: transparent;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    border: none;
    background: transparent;
}

/* Radyo Butonları (Dairesel) */
QRadioButton {
    spacing: 10px;
    color: #e4e4e7;
    font-size: 13px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1.5px solid #3f3f46;
    background-color: #18181b;
}

QRadioButton::indicator:checked {
    background-color: #10b981;
    border: 4px solid #141417;
}

/* Onay Kutuları (Checkboxes) */
QCheckBox {
    spacing: 10px;
    color: #e4e4e7;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1.5px solid #3f3f46;
    background-color: #18181b;
}

QCheckBox::indicator:checked {
    background-color: #059669;
    border: 1.5px solid #10b981;
}

/* Tooltip */
QToolTip {
    background-color: #18181b;
    color: #ffffff;
    border: 1px solid #10b981;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
}
